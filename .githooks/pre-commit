#!/usr/bin/env bash
# devpiano pre-commit hook: 阻止格式违规进入提交（ENG-001 门禁）。
# 仅检查暂存的 source/ 下 .cpp/.h；无 clang-format-21 时跳过（不阻塞提交）。
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

if ! command -v clang-format-21 >/dev/null 2>&1; then
    echo "pre-commit: clang-format-21 not found; skipping format check" >&2
    exit 0
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACM -- 'source/*.cpp' 'source/*.h')"
if [[ -z "${staged_files}" ]]; then
    exit 0
fi

if ! echo "${staged_files}" | xargs clang-format-21 --dry-run --Werror -style=file; then
    echo "pre-commit: format check failed — run ./scripts/dev.sh format, then re-stage" >&2
    exit 1
fi
